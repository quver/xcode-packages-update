{
  "name": "xcode-packages-update",
  "version": "4.0.5",
  "description": "Resolves Xcode SPM dependencies and reports what changed",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "esbuild src/main.entry.ts --bundle --platform=node --format=cjs --define:__PACKAGE_VERSION__=\\\"$npm_package_version\\\" --outfile=dist/main/index.cjs && esbuild src/post.entry.ts --bundle --platform=node --format=cjs --outfile=dist/post/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
